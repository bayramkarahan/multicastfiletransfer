####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/bin || mkdir -p $(INSTALL_ROOT)/usr/bin
	$(QINSTALL_PROGRAM) $(QMAKE_TARGET) $(INSTALL_ROOT)/usr/bin/$(QMAKE_TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/bin/$(QMAKE_TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/bin/ 


install_service: first FORCE
	@test -d $(INSTALL_ROOT)/lib/systemd/system/ || mkdir -p $(INSTALL_ROOT)/lib/systemd/system/
	$(QINSTALL) /home/etapadmin/Masaüstü/multicastfiletransfer/multicastfiletransferclient/multicastfiletransferclient.service $(INSTALL_ROOT)/lib/systemd/system/multicastfiletransferclient.service

uninstall_service: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/lib/systemd/system/multicastfiletransferclient.service
	-$(DEL_DIR) $(INSTALL_ROOT)/lib/systemd/system/ 


install: install_target install_service  FORCE

uninstall: uninstall_target uninstall_service  FORCE

FORCE:

