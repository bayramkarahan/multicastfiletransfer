sub-multicastfiletransferserver-distdir: FORCE
	@test -d multicastfiletransferserver/ || mkdir -p multicastfiletransferserver/
	cd multicastfiletransferserver/ && ( test -e Makefile || $(QMAKE) -o Makefile /home/etapadmin/Masaüstü/multicastfiletransfer/multicastfiletransferserver/multicastfiletransferserver.pro -spec linux-g++ CONFIG+=debug CONFIG+=qml_debug ) && $(MAKE) -e -f Makefile distdir DISTDIR=$(DISTDIR)/multicastfiletransferserver

